# 이 파일을 복사해서 .env로 만들고 실제 값을 채워넣으세요.
# .env는 .gitignore에 의해 절대 Git에 올라가지 않습니다.

# 공공데이터포털 청약홈 분양정보 조회 서비스(odcloud) 인증키
APPLYHOME_API_KEY=

# 국토교통부 공공데이터포털 서비스키
MOLIT_API_KEY=

# 카카오 디벨로퍼스 REST API 키 (주소 정규화용, 지도 API 아님)
KAKAO_API_KEY=

# 한국부동산원 R-ONE(부동산통계정보시스템) 인증키
REB_API_KEY=

# KOSIS(국가통계포털) API 키 - 거시데이터 분기별 매매수급동향용
KOSIS_API_KEY=

# Supabase 프로젝트 정보 (HTTP REST API / Auth 용).
# 아래 DATABASE_URL(PostgreSQL 직접 접속)과는 성격이 완전히 다른 값입니다.
#
# 대시보드 -> Project Settings -> API Keys
# "Publishable and secret API keys"(신버전)를 쓰세요.
# "Legacy anon, service_role"은 구버전이라 단계적으로 폐기됩니다.
SUPABASE_URL=

# sb_publishable_... : 프론트엔드용. 브라우저에 노출돼도 되는 키.
#                      프론트가 Supabase Auth로 로그인할 때 씁니다.
SUPABASE_PUBLISHABLE_KEY=

# sb_secret_...      : 백엔드용. 모든 권한을 통과하므로 절대 노출 금지.
#                      현재 백엔드 코드는 사용하지 않습니다(ORM으로 직접 접속).
#                      향후 Auth Admin / Storage API를 쓸 때 필요합니다.
SUPABASE_SECRET_KEY=

# ORM(SQLAlchemy/Alembic)이 DB에 직접 접속할 때 쓰는 PostgreSQL 연결 문자열.
# 위 SUPABASE_URL/KEY(HTTP REST API용)와는 성격이 완전히 다른 값입니다.
# DBeaver나 psql로 접속할 때 쓰는 그 주소와 같습니다.
#
# 대시보드 -> Connect -> ORMs 탭 (또는 Project Settings -> Database)
#
# ★ 연결 방식이 3가지입니다. 앱(DATABASE_URL)은 Transaction pooler를 쓰세요:
#   - Direct connection (db.xxx.supabase.co:5432)
#       -> IPv6 전용. 한국 인터넷 환경에서 연결이 안 되는 경우가 많음
#   - Session pooler (aws-0-<region>.pooler.supabase.com:5432)
#       -> IPv4 지원. Direct와 동작이 같아서 마이그레이션(DDL)에 적합 -> 아래 MIGRATION_DATABASE_URL에 사용
#       -> 단, 동시 연결이 15개로 제한된다. 팀원 여러 명이 앱 서버를 이 주소로 띄우면 금방 차서
#          모든 DB 요청이 "EMAXCONNSESSION max clients reached"로 실패한다(2026-09-14 실제 발생).
#   - Transaction pooler (aws-0-<region>.pooler.supabase.com:6543)  <-- 앱은 이걸 사용
#       -> 연결 수 한도가 훨씬 커서 여러 명이 동시에 서버를 띄워도 안전
#       -> advisory lock·LISTEN·임시 테이블 같은 세션 단위 기능은 못 쓰지만, 이 코드는 쓰지 않는다
#   두 풀러 모두 사용자명이 postgres 가 아니라 postgres.<프로젝트ref> 형태이고 포트만 다르다.
#
# 형태: postgresql://postgres.xxxxx:[비밀번호]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# [비밀번호]는 API 키가 아니라 프로젝트 생성 시 정한 DB 비밀번호입니다.
# 기억나지 않으면 Settings -> Database -> Reset database password 로 재발급하세요.
DATABASE_URL=

# Alembic 마이그레이션 전용(선택). 위와 같은 주소에서 포트만 5432(Session pooler)로 바꾼 값.
# 비워 두면 Alembic도 DATABASE_URL을 쓴다.
MIGRATION_DATABASE_URL=

# 앱 DB 연결 풀(선택, 서버 프로세스당). 비워 두면 기본값 3 / 2 / 10초.
# 한 프로세스가 동시에 처리하는 DB 요청 수는 POOL_SIZE + MAX_OVERFLOW를 넘지 못한다.
# 개발 중에는 비워 두고, 배포 환경에서 부하에 맞춰 늘린다.
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_POOL_TIMEOUT=

# Supabase가 발급한 JWT(로그인 토큰)의 서명을 백엔드가 검증할 때 쓰는 키.
# 접속용이 아니라 "이 토큰이 위조되지 않았는지" 대조하는 용도입니다.
# 대시보드 -> Project Settings -> API -> JWT Settings -> JWT Secret
#
# 참고: 최근 만든 프로젝트는 비대칭키(ES256/RS256) 서명이 기본일 수 있습니다.
# 그 경우 JWT Secret 대신 JWKS 방식을 써야 하므로, 대시보드에서 어느 쪽인지
# 확인하고 다르면 알려주세요. (app/core/security.py 상단 주석 참고)
SUPABASE_JWT_SECRET=

# Gemini API 키 (AI 브리핑용, 9/10 단계에서 사용)
GEMINI_API_KEY=
